<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Concesionaria</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: Arial, sans-serif; margin: 20px; }
      nav { margin-bottom: 15px; border-bottom: 1px solid #ccc; padding-bottom: 10px; }
      nav a { margin-right: 15px; }
    </style>
  </head>
  <body>
    <nav>
      <strong>Concesionaria Admin</strong>
      <%= link_to "Vehículos", admin_vehicles_path %>
      <%= link_to "Marcas", admin_brands_path %>
      <%= link_to "Modelos", admin_vehicle_models_path %>
      <%= link_to "Test Drives", admin_test_drives_path %>
      <%= link_to "Cerrar sesión", admin_logout_path, data: { turbo_method: :delete } %>
    </nav>
    <% if flash[:notice] %>
      <div style="background-color: #d1fae5; color: #065f46; padding: 10px 14px; border-radius: 6px; margin-bottom: 15px; border: 1px solid #a7f3d0;">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div style="background-color: #fee2e2; color: #991b1b; padding: 10px 14px; border-radius: 6px; margin-bottom: 15px; border: 1px solid #fecaca;">
        <%= flash[:alert] %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>