<h1>Cotizá tu auto</h1>
<p>Completá el formulario y nos ponemos en contacto con la tasación.</p>

<%= form_with model: @appraisal, url: appraisals_path, local: true do |f| %>
  <% if @appraisal.errors.any? %>
    <div style="background:#fee2e2;padding:10px;border-radius:6px;margin-bottom:15px;">
      <% @appraisal.errors.full_messages.each do |msg| %>
        <p style="margin:0;color:#991b1b;"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :make, "Marca" %>
    <%= f.text_field :make, placeholder: "Ej: Ford, Volkswagen, Toyota" %>
  </div>

  <div>
    <%= f.label :car_model, "Modelo" %>
    <%= f.text_field :car_model, placeholder: "Ej: Focus, Gol, Corolla" %>
  </div>

  <div>
    <%= f.label :year, "Año" %>
    <%= f.number_field :year, placeholder: "Ej: 2019" %>
  </div>

  <div>
    <%= f.label :km, "Kilómetros" %>
    <%= f.number_field :km, placeholder: "Ej: 45000" %>
  </div>

  <div>
    <%= f.label :description, "Descripción (opcional)" %>
    <%= f.text_area :description, rows: 4, placeholder: "Estado general, equipamiento, observaciones..." %>
  </div>

  <div>
    <%= f.label :photo, "Foto del auto (opcional)" %>
    <%= f.file_field :photo, accept: "image/*" %>
  </div>

  <%= f.submit "Enviar solicitud de tasación" %>
<% end %>
