<div style="max-width: 700px; margin: 20px auto; background: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); padding: 30px;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px;">
    <div>
      <h2 style="margin: 0; color: #0f172a;">Comprobante de Venta #<%= @sale.id %></h2>
      <div style="font-size: 13px; color: #64748b; margin-top: 4px;">Concesionaria Oficial • Operación cerrada</div>
    </div>
    <div style="text-align: right;">
      <span style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-size: 13px; font-weight: bold; padding: 4px 12px; border-radius: 20px; display: inline-block;">
        ✓ VENTA CONCRETADA
      </span>
      <div style="font-size: 12px; color: #64748b; margin-top: 6px;">Fecha: <%= @sale.formatted_date %></div>
    </div>
  </div>

  <div style="margin-bottom: 25px;">
    <h3 style="font-size: 15px; color: #334155; text-transform: uppercase; margin: 0 0 10px 0; border-bottom: 1px solid #f1f5f9; padding-bottom: 5px;">
      1. Vehículo Vendido
    </h3>
    <div style="display: grid; grid-template-columns: 140px 1fr; row-gap: 8px; font-size: 14px;">
      <span style="color: #64748b; font-weight: bold;">Unidad:</span>
      <span style="color: #0f172a; font-weight: bold; font-size: 16px;"><%= @sale.vehicle.title %></span>

      <span style="color: #64748b; font-weight: bold;">Condición:</span>
      <span><%= @sale.vehicle.used? ? "Usado (#{number_with_delimiter(@sale.vehicle.km, delimiter: '.')} km)" : "0km" %></span>

      <span style="color: #64748b; font-weight: bold;">Estado actual:</span>
      <span style="color: #475569; font-weight: bold;">Vendido (Descontado de stock)</span>
    </div>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 25px;">
    <div style="flex: 1; background: #f8fafc; padding: 15px; border-radius: 6px; border: 1px solid #e2e8f0;">
      <h4 style="margin: 0 0 8px 0; font-size: 13px; color: #475569; text-transform: uppercase;">Cliente Comprador</h4>
      <div style="font-size: 15px; font-weight: bold; color: #0f172a;"><%= @sale.customer.name %></div>
      <div style="font-size: 13px; color: #64748b;"><%= @sale.customer.email %></div>
    </div>

    <div style="flex: 1; background: #f8fafc; padding: 15px; border-radius: 6px; border: 1px solid #e2e8f0;">
      <h4 style="margin: 0 0 8px 0; font-size: 13px; color: #475569; text-transform: uppercase;">Vendedor a Cargo</h4>
      <div style="font-size: 15px; font-weight: bold; color: #0f172a;"><%= @sale.seller.name %></div>
      <div style="font-size: 13px; color: #64748b;"><%= @sale.seller.email %></div>
    </div>
  </div>

  <div style="margin-bottom: 25px;">
    <h3 style="font-size: 15px; color: #334155; text-transform: uppercase; margin: 0 0 10px 0; border-bottom: 1px solid #f1f5f9; padding-bottom: 5px;">
      2. Condiciones Económicas
    </h3>
    <div style="display: grid; grid-template-columns: 180px 1fr; row-gap: 8px; font-size: 14px;">
      <span style="color: #64748b; font-weight: bold;">Precio Final Pactado:</span>
      <span style="color: #1e293b; font-weight: bold; font-size: 20px;"><%= @sale.formatted_price %></span>

      <span style="color: #64748b; font-weight: bold;">Forma de Pago:</span>
      <span style="font-weight: 500;"><%= @sale.payment_method_name %></span>

      <% if @sale.notes.present? %>
        <span style="color: #64748b; font-weight: bold;">Observaciones:</span>
        <span style="color: #475569;"><%= @sale.notes %></span>
      <% end %>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 20px;">
    <div>
      <button onclick="window.print()" style="background-color: #475569; color: white; border: none; padding: 8px 14px; border-radius: 4px; font-weight: bold; cursor: pointer;">
        🖨️ Imprimir Comprobante
      </button>
      <%= link_to "Volver al listado de Ventas", admin_sales_path, style: "margin-left: 15px; color: #475569; text-decoration: none;" %>
    </div>

    <div>
      <%= link_to "Anular esta Venta", admin_sale_path(@sale),
            data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de anular esta venta? El auto volverá a estar Disponible." },
            style: "color: #64748b; text-decoration: none; font-size: 13px;" %>
    </div>
  </div>
</div>
