<h1>Marcas</h1>

<%= link_to "+ Nueva marca", new_admin_brand_path %>

<table border="1" cellpadding="6" style="margin-top: 15px; border-collapse: collapse;">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Modelos asociados</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @brands.each do |brand| %>
      <tr>
        <td><strong><%= brand.name %></strong></td>
        <td><%= brand.vehicle_models.count %> modelos</td>
        <td>
          <%= link_to "Editar", edit_admin_brand_path(brand) %> |
          <%= link_to "Borrar", admin_brand_path(brand), data: { turbo_method: :delete, turbo_confirm: "¿Seguro que querés borrar la marca '#{brand.name}' y todos sus modelos asociados?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
