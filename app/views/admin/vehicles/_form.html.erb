<%= form_with model: [:admin, vehicle] do |f| %>
  <% if vehicle.errors.any? %>
    <div style="color: red;">
      <ul>
        <% vehicle.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :vehicle_model_id, "Modelo" %>
    <%= f.collection_select :vehicle_model_id, VehicleModel.includes(:brand), :id,
          ->(m) { "#{m.brand.name} #{m.name}" }, include_blank: true %>
  </div>
  <div><%= f.label :year, "Año" %> <%= f.number_field :year %></div>
  <div><%= f.label :price, "Precio" %> <%= f.number_field :price, step: 0.01 %></div>
  <div><%= f.label :km, "Kilometraje" %> <%= f.number_field :km %></div>
  <div><%= f.label :used, "Usado" %> <%= f.check_box :used %></div>
  <div><%= f.label :description, "Descripción" %> <%= f.text_area :description %></div>

  <%= f.submit "Guardar" %>
<% end %>