<%= form_with model: [:admin, vehicle], multipart: true do |f| %>
  <% if vehicle.errors.any? %>
    <div style="color: red;">
      <ul>
        <% vehicle.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 10px;">
    <label for="brand_select">Marca</label>
    <select id="brand_select" style="margin-left: 5px;">
      <option value="">Seleccionar marca...</option>
      <% Brand.order(:name).each do |brand| %>
        <option value="<%= brand.id %>" <%= 'selected' if vehicle.vehicle_model&.brand_id == brand.id %>><%= brand.name %></option>
      <% end %>
    </select>
  </div>

  <div style="margin-bottom: 10px;">
    <%= f.label :vehicle_model_id, "Modelo" %>
    <%= f.select :vehicle_model_id, 
          options_for_select(
            VehicleModel.order(:name).map { |m| [m.name, m.id, { 'data-brand-id' => m.brand_id }] },
            vehicle.vehicle_model_id
          ),
          { include_blank: "Seleccionar modelo..." },
          { id: "vehicle_model_select", style: "margin-left: 5px;" } %>
  </div>

  <script>
    (function() {
      function initBrandModelFilter() {
        const brandSelect = document.getElementById("brand_select");
        const modelSelect = document.getElementById("vehicle_model_select");
        if (!brandSelect || !modelSelect) return;

        if (!modelSelect.allOptions) {
          modelSelect.allOptions = Array.from(modelSelect.querySelectorAll("option"));
        }

        function updateModels() {
          const selectedBrandId = brandSelect.value;
          const currentVal = modelSelect.value;

          modelSelect.innerHTML = "";

          modelSelect.allOptions.forEach(option => {
            const brandId = option.getAttribute("data-brand-id");
            if (!option.value || (selectedBrandId && brandId === selectedBrandId)) {
              modelSelect.appendChild(option.cloneNode(true));
            }
          });

          if (currentVal && modelSelect.querySelector(`option[value="${currentVal}"]`)) {
            modelSelect.value = currentVal;
          } else {
            modelSelect.value = "";
          }
        }

        brandSelect.addEventListener("change", updateModels);
        updateModels();
      }

      document.addEventListener("turbo:load", initBrandModelFilter);
      document.addEventListener("DOMContentLoaded", initBrandModelFilter);
      initBrandModelFilter();
    })();
  </script>
  <div><%= f.label :year, "Año" %> <%= f.number_field :year %></div>
  <div style="margin-bottom: 10px;">
    <%= f.label :currency, "Moneda" %>
    <%= f.select :currency, [["Pesos (ARS $)", "ars"], ["Dólares (USD $)", "usd"]], {}, { style: "margin-left: 5px;" } %>
  </div>
  <div style="margin-bottom: 10px;">
    <%= f.label :price, "Precio" %> 
    <%= f.text_field :price, 
          value: (vehicle.price ? (vehicle.price % 1 == 0 ? number_with_delimiter(vehicle.price.to_i, delimiter: ".") : number_with_precision(vehicle.price, precision: 2, delimiter: ".", separator: ",")) : ""), 
          id: "vehicle_price_input", 
          placeholder: "Ej: 23.000.000 o 25.000" %>
  </div>
  <div>
    <%= f.label :km, "Kilometraje" %> 
    <%= f.text_field :km, 
          value: (vehicle.km ? number_with_delimiter(vehicle.km, delimiter: ".") : ""), 
          id: "vehicle_km_input", 
          placeholder: "Ej: 120.000" %>
  </div>
  <div><%= f.label :used, "Usado" %> <%= f.check_box :used %></div>
  <div><%= f.label :description, "Descripción" %> <%= f.text_area :description %></div>

  <div style="margin-top: 15px; margin-bottom: 15px;">
    <label><strong>Fotos del vehículo:</strong></label><br>
    <div id="photos_inputs_list" style="margin-top: 6px;">
      <div style="margin-bottom: 8px;">
        <label style="border: 1px solid #767676; background: #efefef; padding: 2px 7px; font-size: 13px; cursor: pointer; border-radius: 3px; display: inline-block;">
          Seleccionar archivo
          <input type="file" name="vehicle[photos][]" accept="image/*" style="display: none;" onchange="this.parentElement.nextElementSibling.textContent = this.files[0] ? this.files[0].name : 'Ningún archivo seleccionado'">
        </label>
        <span style="font-size: 13px; margin-left: 6px; color: #333;">Ningún archivo seleccionado</span>
      </div>
    </div>
    <button type="button" id="btn_add_more_photos" style="cursor: pointer; padding: 4px 10px; margin-top: 4px; font-weight: bold;">
      + Agregar otra foto
    </button>

    <script>
      (function() {
        function initAddPhotos() {
          const btn = document.getElementById("btn_add_more_photos");
          const container = document.getElementById("photos_inputs_list");
          if (!btn || !container || btn.dataset.ready) return;
          btn.dataset.ready = "true";

          btn.addEventListener("click", function() {
            const row = document.createElement("div");
            row.style.marginBottom = "8px";
            row.innerHTML = '<label style="border: 1px solid #767676; background: #efefef; padding: 2px 7px; font-size: 13px; cursor: pointer; border-radius: 3px; display: inline-block;">Seleccionar archivo<input type="file" name="vehicle[photos][]" accept="image/*" style="display: none;" onchange="this.parentElement.nextElementSibling.textContent = this.files[0] ? this.files[0].name : \'Ningún archivo seleccionado\'"></label> <span style="font-size: 13px; margin-left: 6px; color: #333;">Ningún archivo seleccionado</span> <button type="button" onclick="this.parentElement.remove()" style="color: red; cursor: pointer; border: 1px solid #ccc; background: #fff; padding: 1px 6px; margin-left: 6px;" title="Quitar campo">✕</button>';
            container.appendChild(row);
          });
        }

        document.addEventListener("turbo:load", initAddPhotos);
        document.addEventListener("DOMContentLoaded", initAddPhotos);
        initAddPhotos();
      })();
    </script>

    <% if vehicle.photos.attached? %>
      <div style="margin-top: 15px;">
        <p><strong>Fotos actuales:</strong></p>
        <div>
          <% vehicle.photos.each_with_index do |photo, index| %>
            <div style="display: inline-block; vertical-align: top; margin-right: 15px; margin-bottom: 15px; text-align: center;">
              <%= image_tag photo, style: "width: 160px; height: 110px; object-fit: cover; display: block; border: 1px solid #ccc;" %>
              <div style="font-size: 12px; margin-top: 4px;">
                <% if index == 0 %>
                  <strong>(Portada)</strong><br>
                <% else %>
                  Foto <%= index + 1 %><br>
                <% end %>
                <% if vehicle.persisted? %>
                  <%= link_to "Eliminar", purge_photo_admin_vehicle_path(vehicle, photo_id: photo.id), data: { turbo_method: :delete, turbo_confirm: "¿Eliminar esta foto?" }, style: "color: red;" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <script>
    (function() {
      function sanitizeNumbersOnSubmit(e) {
        const priceInput = document.getElementById("vehicle_price_input");
        const kmInput = document.getElementById("vehicle_km_input");
        if (priceInput && priceInput.value) {
          priceInput.value = priceInput.value.replace(/\./g, "").replace(",", ".");
        }
        if (kmInput && kmInput.value) {
          kmInput.value = kmInput.value.replace(/\./g, "").replace(",", ".");
        }
      }

      document.addEventListener("submit", sanitizeNumbersOnSubmit, true);
    })();
  </script>

  <%= f.submit "Guardar" %>
<% end %>