<h1>Vehículos</h1>

<% if notice %>
  <p style="color: green;"><%= notice %></p>
<% end %>

<%= link_to "+ Nuevo vehículo", new_admin_vehicle_path %>

<table border="1" cellpadding="6" style="margin-top: 10px; border-collapse: collapse;">
  <thead>
    <tr>
      <th>Modelo</th><th>Marca</th><th>Año</th><th>Precio</th><th>Km</th><th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @vehicles.each do |vehicle| %>
      <tr>
        <td><%= vehicle.vehicle_model.name %></td>
        <td><%= vehicle.vehicle_model.brand.name %></td>
        <td><%= vehicle.year %></td>
        <td>$<%= vehicle.price %></td>
        <td><%= vehicle.km %></td>
        <td>
          <%= link_to "Editar", edit_admin_vehicle_path(vehicle) %>
          <%= link_to "Borrar", admin_vehicle_path(vehicle), data: { turbo_method: :delete, turbo_confirm: "¿Seguro?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>