<%= form_with model: [:admin, vehicle_model] do |f| %>
  <% if vehicle_model.errors.any? %>
    <div style="color: red;">
      <ul>
        <% vehicle_model.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= f.label :brand_id, "Marca" %><br>
    <%= f.collection_select :brand_id, Brand.order(:name), :id, :name, { include_blank: "Seleccionar marca..." } %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= f.label :name, "Nombre del Modelo" %><br>
    <%= f.text_field :name, placeholder: "Ej: Corolla, Hilux, Mustang..." %>
  </div>

  <%= f.submit "Guardar Modelo" %>
<% end %>
