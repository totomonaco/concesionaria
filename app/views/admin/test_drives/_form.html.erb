<%= form_with model: [:admin, test_drive], local: true do |f| %>
  <% if test_drive.errors.any? %>
    <div style="background-color: #fee2e2; border: 1px solid #f87171; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
      <strong style="display: block; margin-bottom: 5px;">Se encontraron los siguientes errores:</strong>
      <ul style="margin: 0; padding-left: 20px;">
        <% test_drive.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= f.label :vehicle_id, "Vehículo a probar", style: "font-weight: bold; display: block; margin-bottom: 5px;" %>
    <%= f.collection_select :vehicle_id,
          Vehicle.includes(vehicle_model: :brand).order("brands.name ASC, vehicle_models.name ASC"),
          :id, :display_name,
          { prompt: "Seleccionar vehículo..." },
          { required: true, style: "width: 100%; max-width: 500px; padding: 6px 10px;" } %>
  </div>

  <div style="margin-bottom: 15px; border: 1px solid #e5e7eb; padding: 15px; border-radius: 6px; max-width: 500px; background-color: #f8fafc;">
    <label style="font-weight: bold; display: block; margin-bottom: 8px;">Cliente</label>

    <div style="margin-bottom: 10px;">
      <label style="display: block; font-size: 13px; color: #475569; margin-bottom: 3px;">Seleccionar cliente existente:</label>
      <%= f.collection_select :user_id,
            User.order(:name),
            :id, :display_name,
            { prompt: "Elegir cliente registrado..." },
            { id: "existing_user_select", style: "width: 100%; padding: 6px 10px;" } %>
    </div>

    <div style="text-align: center; margin: 10px 0; font-size: 12px; color: #64748b; font-weight: bold;">
      — O REGISTRAR NUEVO CLIENTE RÁPIDO —
    </div>

    <div style="display: flex; gap: 10px;">
      <div style="flex: 1;">
        <label style="display: block; font-size: 13px; color: #475569; margin-bottom: 3px;">Nombre completo:</label>
        <%= text_field_tag :new_customer_name, params[:new_customer_name], placeholder: "Ej: Juan Pérez", style: "width: 100%; padding: 6px 10px; box-sizing: border-box;" %>
      </div>
      <div style="flex: 1;">
        <label style="display: block; font-size: 13px; color: #475569; margin-bottom: 3px;">Email:</label>
        <%= email_field_tag :new_customer_email, params[:new_customer_email], placeholder: "juan@ejemplo.com", style: "width: 100%; padding: 6px 10px; box-sizing: border-box;" %>
      </div>
    </div>
  </div>

  <div style="display: flex; gap: 20px; max-width: 500px; margin-bottom: 15px;">
    <div style="flex: 1;">
      <%= f.label :scheduled_date, "Fecha", style: "font-weight: bold; display: block; margin-bottom: 5px;" %>
      <%= f.date_field :scheduled_date, min: Date.current, required: true, style: "width: 100%; padding: 6px 10px; box-sizing: border-box;" %>
    </div>

    <div style="flex: 1;">
      <%= f.label :scheduled_time, "Hora", style: "font-weight: bold; display: block; margin-bottom: 5px;" %>
      <%= f.time_field :scheduled_time, required: true, style: "width: 100%; padding: 6px 10px; box-sizing: border-box;" %>
    </div>
  </div>

  <div style="margin-bottom: 20px; max-width: 500px;">
    <%= f.label :status, "Estado del turno", style: "font-weight: bold; display: block; margin-bottom: 5px;" %>
    <%= f.select :status,
          [["Pendiente", "pending"], ["Confirmado", "confirmed"], ["Cancelado", "cancelled"]],
          {},
          { style: "width: 100%; padding: 6px 10px;" } %>
  </div>

  <div style="display: flex; gap: 10px; align-items: center;">
    <%= f.submit test_drive.new_record? ? "Agendar Test Drive" : "Actualizar Test Drive",
          style: "background-color: #2563eb; color: white; padding: 8px 16px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;" %>
    <%= link_to "Volver al listado", admin_test_drives_path, style: "color: #4b5563; text-decoration: none; margin-left: 10px;" %>
  </div>
<% end %>
